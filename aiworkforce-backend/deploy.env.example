# Copied to deploy.env on the server. Do not commit deploy.env.
# Keep this at the temporary localhost port until the final API hostname is ready.
API_PORT=5002

# Use the final frontend hostname(s) once the department confirms them.
# During API-only deployment, no browser traffic reaches the service yet.
ALLOWED_ORIGINS=https://aiworkforce.turnpro.dev

# Absolute server path. The JSON file must be readable by Docker, but must not be
# copied into the repository or Docker image.
FIREBASE_SERVICE_ACCOUNT_HOST_PATH=/opt/aiworkforce/secrets/firebase-service-account.json
